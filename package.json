{
	"name": "blockbench-touch",
	"version": "0.1.0",
	"private": true,
	"description": "Private iOS port of Blockbench with touch support (Capacitor)",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"build": "node scripts/build-web.mjs",
		"build:fast": "node scripts/build-web.mjs --skip-upstream",
		"sync": "npm run build && npx cap sync ios",
		"serve": "node scripts/serve.mjs",
		"test:web": "node scripts/smoke-test.cjs",
		"test:touch": "node scripts/test-touch.cjs",
		"test": "node scripts/smoke-test.cjs && node scripts/test-touch.cjs"
	},
	"dependencies": {
		"@capacitor/core": "^8.6.2",
		"@capacitor/filesystem": "^8.1.5",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/share": "^8.0.3"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.2",
		"@capacitor/ios": "^8.6.2"
	}
}
