{
	"name": "blockbench-touch",
	"version": "1.0.0",
	"private": true,
	"description": "Private iOS port of Blockbench with touch support (Capacitor)",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"build": "node scripts/build-web.mjs",
		"build:fast": "node scripts/build-web.mjs --skip-upstream",
		"sync": "npm run build && npx cap sync ios",
		"serve": "node scripts/serve.mjs",
		"test:web": "node scripts/smoke-test.cjs",
		"test:touch": "node scripts/test-touch.cjs",
		"test:files": "node scripts/test-files.cjs",
		"test:ui": "node scripts/test-ui.cjs",
		"test:generic": "node scripts/test-generic.cjs",
		"test:pencil": "node scripts/test-pencil.cjs",
		"test": "node scripts/smoke-test.cjs && node scripts/test-touch.cjs && node scripts/test-files.cjs && node scripts/test-ui.cjs && node scripts/test-generic.cjs && node scripts/test-pencil.cjs && node scripts/test-offline.cjs",
		"test:offline": "node scripts/test-offline.cjs"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.6.2",
		"@capacitor/filesystem": "^8.1.5",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/share": "^8.0.3"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.2",
		"@capacitor/ios": "^8.6.2"
	}
}
